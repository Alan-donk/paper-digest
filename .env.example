# Optional LLM: any provider exposing an OpenAI-compatible /chat/completions API.
# Leave LLM_API_KEY empty to use local fallback summaries instead.
LLM_API_KEY=your_api_key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# DEEPSEEK_API_KEY / DEEPSEEK_BASE_URL / DEEPSEEK_MODEL remain supported for
# backwards compatibility. Do not set both LLM_* and DEEPSEEK_* variables.

# SMTP email delivery
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_username
SMTP_PASS=your_app_password
EMAIL_FROM=sender@example.com
EMAIL_TO=recipient@example.com
